# ---------------------------------------------------------------------------
# FileDrop — example environment. Copy to .env and change every secret value.
#   cp .env.example .env
# The real .env must never be committed.
# ---------------------------------------------------------------------------

# --- Admin credentials (single administrator) ------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123

# Secret used to sign admin sessions and share-access tokens.
# Leave empty and one is generated + persisted in the data volume on first boot.
SESSION_SECRET=

# --- Limits ----------------------------------------------------------------
# Maximum bytes for a single upload batch.
MAX_BATCH_BYTES=20000000000
# Maximum bytes of active uploaded data across the whole service.
STORAGE_LIMIT_BYTES=20000000000
# Lifetime of a completed share, in hours.
SHARE_EXPIRY_HOURS=24
# Incomplete uploads are deleted after this many hours of inactivity.
INCOMPLETE_UPLOAD_TIMEOUT_HOURS=2
# Upload chunk size in bytes. Must stay below the request-body limit of the
# Cloudflare plan in use (free plan: 100 MB). 16 MiB by default.
CHUNK_SIZE_BYTES=16777216

# --- Sessions --------------------------------------------------------------
ADMIN_SESSION_HOURS=8
# How long a visitor stays authenticated to a password-protected share.
SHARE_TOKEN_HOURS=6

# --- Logging ---------------------------------------------------------------
# Total retained log size across all rotated files.
LOG_MAX_SIZE_MB=50
LOG_LEVEL=info

# --- Server ----------------------------------------------------------------
PORT=8140
HOST=0.0.0.0
# Public origin used to build share links.
PUBLIC_BASE_URL=https://link.madhur.dev
# Secondary origin (optional, informational only).
# Sites allowed to create shares from the browser, comma-separated (e.g. the vault)
# CORS_ORIGINS=https://id.madhur.dev
SECONDARY_BASE_URL=https://madhur.dev
# Extra share IDs that must never be generated, comma separated. These are
# merged with the built-in reserved list (application + madhur.dev routes).
RESERVED_IDS=

# --- Cleanup ---------------------------------------------------------------
CLEANUP_INTERVAL_SECONDS=60
